# Where form submissions are forwarded (CRM, Zapier, Make, HubSpot, Apps Script, ...).
# Optional: when unset, every submission is only logged as "[lead] {...}" in the
# server / Vercel function logs and the form still shows its success message.
# Set it in Vercel → Project → Settings → Environment Variables, then redeploy.
LEAD_WEBHOOK_URL=

# Optional: sent as "Authorization: Bearer <secret>" to the webhook.
LEAD_WEBHOOK_SECRET=
